NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — Google Analytics 4 measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# AI support chatbot — server-side only. Never prefix with NEXT_PUBLIC_.
# Create a free API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional model override. Default: openrouter/free (routes across free models)
OPENROUTER_MODEL=openrouter/free
